# ==============================================================================
# Multi-Agent Deep Researcher Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Search Engine Providers
# ------------------------------------------------------------------------------
# LinkUp API Key (Optional if using DuckDuckGo)
# Get your free key at: https://app.linkup.so/sign-up
LINKUP_API_KEY=your_linkup_api_key_here

# ------------------------------------------------------------------------------
# 2. LLM Providers (Configure at least ONE or run Ollama locally)
# ------------------------------------------------------------------------------
# Preferred Provider: openai | groq | anthropic | gemini | deepseek | ollama
# If left empty, system auto-detects based on which API key is present.
LLM_PROVIDER=

# Model override (e.g. gpt-4o-mini, llama-3.3-70b-versatile, deepseek-r1:7b)
LLM_MODEL=

# OpenAI Configuration
OPENAI_API_KEY=

# Groq Configuration (Ultra fast & generous free tier - https://console.groq.com)
GROQ_API_KEY=

# Anthropic Configuration (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Gemini Configuration (https://aistudio.google.com)
GEMINI_API_KEY=

# DeepSeek API Configuration (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Local Ollama Configuration (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
# Port for Web UI & REST API server (default: 5000)
PORT=5000
